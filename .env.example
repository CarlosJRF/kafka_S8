# Copy to .env and adjust. docker compose reads it automatically.

# Public port of the API Gateway (use 80 on EC2).
GATEWAY_PORT=8080

# OAuth2 clients (Client Credentials). Change the secrets outside local development.
BANKING_CLIENT_ID=banking-client
BANKING_CLIENT_SECRET=banking-secret
RESILIENT_CLIENT_ID=resilient-client
RESILIENT_CLIENT_SECRET=resilient-secret

# PostgreSQL credentials.
DB_USER=banking
DB_PASSWORD=banking

# Memory limit of every Spring Boot container.
SERVICE_MEM_LIMIT=512m

# Ingest the CSV files automatically when data-ingestion-service starts.
INGESTION_RUN_ON_STARTUP=false
